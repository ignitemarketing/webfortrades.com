{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webfortrades",
  "compatibility_date": "2026-07-01",
  // Serve only on webfortrades.com: no <name>.colin4567.workers.dev copy
  // and no preview URLs competing with the canonical host.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
