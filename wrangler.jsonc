{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webfortrades",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
  // Worker secrets (set once, never committed): POSTMARK_SERVER_TOKEN,
  // NOTIFY_TO, NOTIFY_FROM. See worker/index.ts.
}
